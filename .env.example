# Directory of Markdown notes (absolute or relative to cwd)
KNOWLEDGE_ROOT=./knowledge

# Public origin of this server (Cloudflare Tunnel hostname, no trailing slash)
BETTER_AUTH_URL=https://mcp.example.com

# Secret used to sign sessions and OAuth artifacts (generate a long random string)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Protected MCP resource identifier. HTTPS, no query or fragment.
# Must match BETTER_AUTH_URL + /mcp
MCP_RESOURCE=https://mcp.example.com/mcp

# Local HTTP port. Cloudflare Service URL must be http://127.0.0.1:8787
MCP_HTTP_PORT=8787

# Created on first HTTP boot if the user table is empty. Sign-up stays disabled.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=replace-with-a-strong-password
OWNER_NAME=Owner
