{
  "name": "study-with-ai",
  "version": "1.0.0",
  "description": "Model-agnostic MCP server for a personal Markdown study knowledge base",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "study-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "auth:migrate": "npx @better-auth/cli@latest migrate --config src/auth.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "mcp",
    "study",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@better-auth/cimd": "^1.7.20",
    "@better-auth/mcp": "^1.7.20",
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "^1.7.20",
    "hono": "^4.13.18",
    "minisearch": "^7.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
